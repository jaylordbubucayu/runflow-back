<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>You're registered</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <!-- Preheader (hidden preview text) -->
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      You're in! Your registration for {{eventName}} is confirmed.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:480px;background-color:#ffffff;border-radius:12px;overflow:hidden;">
            <!-- Header -->
            <tr>
              <td style="background-color:#111827;padding:24px 32px;">
                <span style="font-size:20px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#ffffff;">
                  {{appName}}
                </span>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#111827;">
                  You're registered!
                </h1>

                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
                  {{#if firstName}}Hi {{firstName}},{{else}}Hi there,{{/if}}
                </p>

                <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#374151;">
                  Your payment was received and your spot in <strong>{{eventName}}</strong> is confirmed.
                </p>

                <!-- Details -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;">
                  <tr>
                    <td style="padding:16px 20px 0;">
                      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Event</p>
                      <p style="margin:2px 0 0;font-size:15px;font-weight:600;color:#111827;">{{eventName}}</p>
                    </td>
                  </tr>
                  {{#if eventDate}}
                  <tr>
                    <td style="padding:12px 20px 0;">
                      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Date</p>
                      <p style="margin:2px 0 0;font-size:15px;color:#111827;">{{eventDate}}</p>
                    </td>
                  </tr>
                  {{/if}}
                  <tr>
                    <td style="padding:12px 20px 0;">
                      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Category</p>
                      <p style="margin:2px 0 0;font-size:15px;color:#111827;">{{categoryName}}</p>
                    </td>
                  </tr>
                  {{#if bibNumber}}
                  <tr>
                    <td style="padding:12px 20px 0;">
                      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Bib number</p>
                      <p style="margin:2px 0 0;font-size:15px;font-weight:700;color:#111827;">{{bibNumber}}</p>
                    </td>
                  </tr>
                  {{/if}}
                  <tr>
                    <td style="padding:12px 20px 16px;">
                      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#6b7280;">Registration code</p>
                      <p style="margin:2px 0 0;font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;font-size:15px;font-weight:700;letter-spacing:1px;color:#111827;">{{registrationCode}}</p>
                    </td>
                  </tr>
                </table>

                <p style="margin:24px 0 0;font-size:14px;line-height:1.6;color:#6b7280;">
                  Keep this email. You may be asked for your registration code or bib number at race-kit pickup.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="border-top:1px solid #e5e7eb;padding:20px 32px;">
                <p style="margin:0;font-size:12px;line-height:1.5;color:#9ca3af;">
                  You're receiving this because you registered for an event on {{appName}}.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
